# ============================================
# Sabia Contable - Variables de entorno (EJEMPLO)
# ============================================
# COPIAR a .env.local y reemplazar con valores reales.
# NUNCA commitear .env.local al repositorio.

# ---- Mailing (Resend) ----
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=

# ---- Google reCAPTCHA v3 ----
# Obtener en: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- Email destino del formulario de contacto ----
# Coma-separado para múltiples destinatarios
CONTACT_TO_EMAIL=contacto@sabiacontable.cl

# ---- App ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# MVP contable (Fase 1 en adelante)
# ============================================

# ---- Database (Postgres) ----
# 1 BD por instalación (cliente de la firma)
DATABASE_URL=postgresql://sabia_user:sabia_pass@localhost:5432/sabia_dev

# ---- Auth ----
# Generar con: openssl rand -base64 32
# DISTINTO por instalación, NUNCA reutilizar
AUTH_SECRET=

# ---- Redis (cache + sesiones + cola BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Storage (S3 / MinIO) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=sabia-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# ---- Instalación actual (resuelta también por subdominio en middleware) ----
INSTALLATION_SLUG=dev
