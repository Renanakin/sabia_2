# ============================================
# Sabia Contable - Variables de entorno (EJEMPLO)
# ============================================
# COPIAR a .env.local y reemplazar con valores reales.
# NUNCA commitear .env.local al repositorio.

# ---- Mailing (Resend) ----
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=

# ---- Google reCAPTCHA v3 ----
# Obtener en: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- Email destino del formulario de contacto ----
# Coma-separado para múltiples destinatarios
CONTACT_TO_EMAIL=contacto@sabiacontable.cl

# ---- App ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Dominio raíz (usado por middleware) ----
# En dev: localhost. En prod: sabiacontable.cl
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# ============================================
# MVP contable (Fase 1)
# ============================================

# ---- Database (Postgres 16) ----
# 1 BD por instalación (cliente de la firma)
# En dev, docker compose levanta el servicio `db` con estas credenciales.
POSTGRES_DB=sabia_dev
POSTGRES_USER=sabia_user
POSTGRES_PASSWORD=sabia_dev_password_change_me
DATABASE_URL=postgresql://sabia_user:sabia_dev_password_change_me@localhost:5432/sabia_dev

# ---- Auth ----
# Generar con: openssl rand -base64 32
# DISTINTO por instalación, NUNCA reutilizar
AUTH_SECRET=dev_only_change_in_prod_min_32_chars_xxxxxxxx

# ---- Redis (cache + sesiones + cola BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Storage (S3 / MinIO) ----
# En dev, docker compose levanta MinIO
# STORAGE_ENDPOINT: endpoint INTERNO (para subir/bajar desde el server)
# STORAGE_PUBLIC_ENDPOINT: endpoint PÚBLICO (para URLs firmadas que verá el navegador)
# En dev, ambos son http://localhost:9000. En prod, el público sería el dominio/CDN.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=sabia-dev
MINIO_ROOT_USER=sabia_minio
MINIO_ROOT_PASSWORD=sabia_minio_dev_password_change_me
STORAGE_ACCESS_KEY=sabia_minio
STORAGE_SECRET_KEY=sabia_minio_dev_password_change_me
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# ---- Instalación actual (dev) ----
# En multi-install esto se resuelve por subdominio en middleware.
INSTALLATION_SLUG=dev
